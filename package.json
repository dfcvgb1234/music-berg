{
  "name": "music-berg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "next lint",
    "migrate:blob-to-r2": "node scripts/migrate-blob-to-r2.mjs",
    "migrate:blob-to-r2:execute": "node scripts/migrate-blob-to-r2.mjs --execute",
    "migrate:audio-data-to-r2": "node scripts/migrate-audio-data-to-r2.mjs",
    "migrate:audio-data-to-r2:execute": "node scripts/migrate-audio-data-to-r2.mjs --execute",
    "verify:r2-audio": "node scripts/verify-r2-audio.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@aws-sdk/s3-request-presigner": "^3.1179.0",
    "@electric-sql/pglite": "^0.6.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@vercel/blob": "^2.9.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
